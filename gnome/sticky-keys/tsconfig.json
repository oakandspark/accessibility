{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "sourceMap": false,
    "strict": true,
    "skipLibCheck": true,
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],

    // Required for decorators like @GObject.registerClass
    "experimentalDecorators": true,
  },
  "include": [
    "ambient.d.ts",
  ],
  "files": [
    "extension.ts", "indicator.ts",
  ],
}

